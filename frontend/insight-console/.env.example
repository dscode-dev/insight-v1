# Insight Console — local environment template.
#
# Sprint 8. Copy to .env.local; never commit real values.

# Admin API base URL (server-side only). In Robozão, this is the Google Cloud
# public platform entrypoint and always lands on Insight Gateway.
ADMIN_API_BASE_URL=https://insight-api.konohalabs.com.br/v1

# Internal Robozão operations gateway (server-side only). Console public URL on
# the internal network is http://insight-robozao.konohalabs.lab/console/v1.
ROBOZAO_GATEWAY_URL=http://robozao-gateway:8095

# Service-to-service token the admin API uses to identify the Console
# as a trusted internal client. Requests without it are rejected on
# /v1/console/* (defence-in-depth on top of the operator JWT).
ADMIN_API_INTERNAL_TOKEN=replace-me-32-chars-min

# JWT verification — production: provide a JWKS URL OR an SPKI public
# key. Dev only: HS256 with a shared secret.
CONSOLE_JWKS_URL=
CONSOLE_JWT_PUBLIC_KEY=
CONSOLE_JWT_DEV_SECRET=lab-secret-do-not-use-in-prod
CONSOLE_JWT_ISSUER=insight-gateway
CONSOLE_JWT_AUDIENCE=insight-console

# Nexus admin API (server-side only) — publication tickets, candidates,
# personas, LLM health, console audit. Sprint 4.5.
NEXUS_BASE_URL=http://localhost:8090
