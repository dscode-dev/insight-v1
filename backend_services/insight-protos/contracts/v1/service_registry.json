      "mutable": false,
      "dependencies": ["postgres", "redis"],
      "lifecycle": "frozen",
      "endpointKey": "atlas",
      "capabilities": ["atlas.health.read", "atlas.intelligence.read", "atlas.replay.read"],
      "operations": {
        "transport": "grpc",
        "endpoint_env": "ATLAS_OPERATIONS_GRPC_ADDR",
        "default_endpoint": "atlas:9081",
        "enabled_env": "ATLAS_OPERATIONS_ENABLED",
        "default_enabled": true
      }
    },
