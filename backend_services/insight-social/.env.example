# insight-social local env — copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real values.

# --- service identity ---
INSIGHT_SERVICE=insight-social
INSIGHT_VERSION=dev

# --- gRPC + HTTP listeners ---
GRPC_ADDR=:50051
HTTP_ADDR=:8080
GRPC_MAX_RECV_MSG_BYTES=4194304

# --- Postgres ---
# Logical DB `insight_social` on the shared cluster. During overlap
# Schema inherited from the legacy service — locked, no dual-writes
# because Strangler routes each endpoint to exactly one runtime.
DATABASE_URL=postgres://insight:insight@localhost:5432/insight_social?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTO_APPLY_MIGRATIONS=true

# --- Redis (HumanSignal target) ---
REDIS_URL=redis://localhost:6379/0
HUMAN_SIGNAL_STREAM_PREFIX=insight:stream:human_signal
STREAM_PARTITIONS=8

# --- mTLS (leave empty for local plaintext) ---
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# --- observability ---
LOG_LEVEL=debug
LOG_PRETTY=true
INSIGHT_OTLP_ENDPOINT=
INSIGHT_OTLP_SAMPLE_RATIO=1.0
# Gateway-only agent operations. Empty disables the mutation endpoints.
SOCIAL_OPS_TOKEN=
