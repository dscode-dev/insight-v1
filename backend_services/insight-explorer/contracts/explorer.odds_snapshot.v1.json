{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.insight.konohalabs.com.br/explorer/explorer.odds_snapshot.v1.json",
  "title": "explorer.odds_snapshot.v1",
  "description": "One bookmaker market snapshot at an instant. entity_type='odds_snapshot'. Maps to Sport Hub 'match.odds' (requires market + bookmaker downstream in Atlas). PRODUCT RULE: margins/overround/arbitrage are internal model inputs only — never surfaced publicly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_fixture_id", "bookmaker", "market", "captured_at", "selections"],
  "properties": {
    "external_fixture_id": { "type": "string", "minLength": 1 },
    "bookmaker": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 1, "description": "e.g. '1x2', 'over_under_2_5', 'btts'." },
    "captured_at": { "type": "string", "format": "date-time" },
    "selections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "e.g. 'home','draw','away','over','under'." },
          "price": { "type": "number", "exclusiveMinimum": 1, "description": "Decimal odds." },
          "point": { "type": ["number", "null"], "description": "Handicap/total line when applicable." }
        }
      }
    }
  }
}
