{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Atlas \u2014 Real-Time Intelligence (Sprint 6.2)",
  "uid": "atlas-intelligence",
  "tags": [
    "atlas",
    "intelligence",
    "sprint-6.2"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Event Impact rate by tier",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (impact) (rate(event_impact_total[5m]))",
          "legendFormat": "{{impact}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Signals generated by type",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (signal_type) (rate(signals_generated_total[5m]))",
          "legendFormat": "{{signal_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Publication decisions (published vs suppressed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
