        {
          "expr": "sum(rate(trends_suppressed_total[5m]))",
          "legendFormat": "suppressed (cooldown)"
        },
        {
          "expr": "sum(rate(trends_publish_failed_total[5m]))",
          "legendFormat": "publish failed"
        }
      ]
    },
    {
      "id": 10,
      "title": "Trend detection latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(trend_detection_latency_seconds_bucket[5m])))",
          "legendFormat": "full set p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(trend_engine_latency_seconds_bucket[5m])))",
          "legendFormat": "{{engine}} p95"
        }
      ]
