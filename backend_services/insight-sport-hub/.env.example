# insight-sports-hub — local env (copy to .env)
INSIGHT_SERVICE=insight-sports-hub
INSIGHT_VERSION=dev
HTTP_ADDR=:8080

DATABASE_URL=postgres://insight:insight@localhost:5432/insight_sports_hub?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Validation tunables
VALIDATION_FUTURE_SKEW_SECONDS=300

# Observability
LOG_LEVEL=debug
LOG_PRETTY=true
INSIGHT_OTLP_ENDPOINT=
INSIGHT_OTLP_SAMPLE_RATIO=1.0

# --- Sprint 2: provider adapters ---
# Empty values skip the corresponding adapter at boot (logged warn).
# Get keys from:
#   API-Football    https://www.api-football.com/
#   football-data   https://www.football-data.org/client/register
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_BASE_URL=

# --- Sprint 3: scheduler / queue / runner ---
# Interval between planning ticks (seconds). 30s is the default
# cadence; finer cadences are bounded by the tightest PollPolicy.
SCHEDULER_INTERVAL_SECONDS=30
# Max queued SyncJobs at any one time. Enqueue past this fails
# fast (logged) — the next tick re-plans.
SCHEDULER_QUEUE_CAPACITY=1024
# Worker pool size consuming the queue.
JOB_RUNNER_WORKERS=4

# --- Sprint 4: distributed queue ---
# QUEUE_BACKEND chooses the transport implementing ports.JobQueue:
#   "inmemory" (default, dev/lab) — single-process bounded channel
#   "redis"                       — Redis Streams + consumer group
QUEUE_BACKEND=inmemory
# Redis connection settings used only when QUEUE_BACKEND=redis.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=insight:queue:syncjobs
REDIS_GROUP=insight-syncjob-workers
# REDIS_CONSUMER defaults to "<hostname>-<pid>" when empty — unique
# per pod, what consumer-group semantics require.
REDIS_CONSUMER=
REDIS_RETRY_ZSET=insight:queue:syncjobs:retry
# Approximate MAXLEN trim cap — XADD MAXLEN ~ N.
REDIS_MAX_LEN=10000
