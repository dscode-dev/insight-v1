# Configuração local. NENHUM segredo preenchido aqui, e isso é a regra:
# um segredo com valor padrão sobrevive ao desenvolvimento, atravessa o
# staging e chega em produção sem que ninguém tenha decidido usá-lo.
#
# Copie para `.env` e preencha o que precisar. `.env` é ignorado pelo git.

ENGINE_ENVIRONMENT=local
ENGINE_LOG_LEVEL=INFO

# --- EXIGIDO para o processo subir -------------------------------------
# Autentica chamadas entre serviços do Insight. Sem default, deliberadamente.
ENGINE_SECURITY_INTERNAL_TOKEN=

# Origens de CORS, separadas por vírgula. Vazio = nenhuma, que é o certo
# para uma API interna.
ENGINE_SECURITY_ALLOWED_ORIGINS=

# --- EXIGIDO desde o PR-02: o registro de intake ------------------------
# Os valores abaixo casam com `infra/docker-compose.yml`.
ENGINE_POSTGRES_HOST=localhost
ENGINE_POSTGRES_PORT=5433
ENGINE_POSTGRES_DATABASE=sports_intelligence
ENGINE_POSTGRES_USER=engine
ENGINE_POSTGRES_PASSWORD=engine_local

# O arquivo bruto. `backend=filesystem` existe para desenvolvimento sem
# Docker e é RECUSADO em staging/production na inicialização: uma pasta
# local não sobrevive ao contêiner, e o que ela guardaria é a única camada
# que não se reconstrói (ADR-0004, ADR-0014).
ENGINE_OBJECT_STORE_BACKEND=s3
ENGINE_OBJECT_STORE_BUCKET=sports-intelligence-raw
ENGINE_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
ENGINE_OBJECT_STORE_ACCESS_KEY_ID=minioadmin
ENGINE_OBJECT_STORE_SECRET_ACCESS_KEY=minioadmin
ENGINE_OBJECT_STORE_SECURE=false
# ENGINE_OBJECT_STORE_ROOT_PATH=./.raw-archive   # só com backend=filesystem

# Tetos da ingestão. Todos têm default; nenhum é segredo. Estão aqui para
# que ajustá-los não exija um deploy.
# ENGINE_INTAKE_MAX_FILE_SIZE_BYTES=2147483648
# ENGINE_INTAKE_MAX_ROWS_PER_FILE=50000000
# ENGINE_INTAKE_MAX_VALIDATION_ISSUES=200
# ENGINE_INTAKE_MAX_FILES_PER_DATASET=200

# --- Declarados e ainda NÃO usados -------------------------------------
# Cada bloco entra em uso no PR que o alcançar. `engine doctor` reporta
# quais estão configurados sem exigir nenhum deles.

# ENGINE_CLICKHOUSE_HOST=localhost
# ENGINE_CLICKHOUSE_DATABASE=insight_engine
# ENGINE_CLICKHOUSE_USER=
# ENGINE_CLICKHOUSE_PASSWORD=

# ENGINE_REDIS_HOST=localhost

# ENGINE_OTEL_EXPORTER_ENDPOINT=
# ENGINE_OTEL_TRACES_ENABLED=false
