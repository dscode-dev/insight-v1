# Copy to .env.local and fill in real values for `make run`.

# --- Service identity ---
INSIGHT_SERVICE=insight-gateway
INSIGHT_VERSION=dev

# --- HTTP ---
HTTP_ADDR=:8080
REQUEST_TIMEOUT_SECONDS=10
DEFAULT_BODY_MAX_BYTES=1048576

# --- Strangler routing target ---
# Standalone by default. Set LEGACY_UPSTREAM_BASE_URL only for an
# overlap deployment with a legacy BFF still serving traffic.
LEGACY_UPSTREAM_BASE_URL=

# --- Postgres (insight_auth — owned by the gateway) ---
DATABASE_URL=postgresql://insight:insight@localhost:5432/insight_auth?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTO_APPLY_MIGRATIONS=false

# --- Redis (rate limit + OTP cooldown + realtime broker tail) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT — fill all 3 secrets to enable native auth) ---
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=insight.gateway
JWT_AUDIENCE=insight.client
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_REGISTRATION_TTL_SECONDS=600

# --- Auth (OTP) ---
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HMAC_SECRET=
PHONE_DEFAULT_REGION=BR

# --- Auth provider (Gateway-owned phone verification) ---
# local = Gateway-generated OTP + SMS_PROVIDER below (rollback/dev)
# supabase = Gateway calls Supabase Auth OTP APIs; Supabase is NOT identity.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Robozão administrative execution ---
# Shared only with robozao-gateway. Empty disables the internal mutation routes.
GATEWAY_OPS_TOKEN=
SPORT_HUB_HTTP_BASE_URL=http://sport-hub:8080
SPORT_HUB_OPS_TOKEN=
SOCIAL_OPS_TOKEN=

# --- Atlas -> Gateway -> Anvil analytics bridge ---
# Atlas and Anvil use separate credentials. Empty values disable the route.
ATLAS_ANVIL_API_KEY=
ANVIL_API_BASE_URL=http://localhost:8081
ANVIL_API_KEY=

# --- SMS provider: null | zenvia | twilio ---
SMS_PROVIDER=null
SMS_MESSAGE_TEMPLATE=Seu código Insight é {code}. Não compartilhe com ninguém.
ZENVIA_API_TOKEN=
ZENVIA_SENDER_ID=Insight
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# --- Realtime (SSE) ---
DERIVED_STREAM_BASE_KEY=insight:stream:derived
STREAM_PARTITIONS=8
REALTIME_BLOCK_MS=2000
REALTIME_SUBSCRIBER_QUEUE_MAX=1000
SSE_KEEPALIVE_SECONDS=15

# --- Strangler rollout flags (per-endpoint) ---
# Rollout flags only matter with a legacy upstream; standalone ignores them.
# shadow              → call Go in parallel, response discarded
# 1..100              → percent of traffic served by Go
ENABLE_GO_AUTH_OTP_REQUEST=
ENABLE_GO_AUTH_OTP_VERIFY=
ENABLE_GO_AUTH_REGISTER=
ENABLE_GO_AUTH_REFRESH=
ENABLE_GO_REALTIME_SSE=

# --- Observability ---
LOG_LEVEL=info
LOG_PRETTY=true
INSIGHT_OTLP_ENDPOINT=
INSIGHT_OTLP_SAMPLE_RATIO=1.0

# --- AppSec ---
ENABLE_HSTS=false
CSP_OVERRIDE=
