{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Insight Gateway \u2014 Social BFF",
  "uid": "insight-gateway-social-bff",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "insight",
    "gateway",
    "social-bff"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(gateway_social_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p95 by route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gateway_social_latency_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(gateway_social_errors_total[5m]))",
          "legendFormat": "{{route}} errors"
        },
        {
          "expr": "sum(rate(gateway_social_errors_total[5m])) / clamp_min(sum(rate(gateway_social_requests_total[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Feed traffic",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (feed) (rate(gateway_feed_reads_total[5m]))",
          "legendFormat": "{{feed}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Post traffic",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(gateway_post_writes_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Relationship traffic",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(gateway_follow_actions_total[5m]))",
          "legendFormat": "{{action}}"
        },
        {
          "expr": "sum by (action) (rate(gateway_mute_actions_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}