{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Nexus \u2014 Communication Orchestration (Sprint 2)",
  "uid": "nexus-foundation",
  "tags": [
    "nexus",
    "agents",
    "sprint-2"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Trend consumption",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(nexus_trends_consumed_total[5m])",
          "legendFormat": "trends/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Agent activity \u2014 drafts generated",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(agent_drafts_generated_total[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory usage \u2014 hits vs misses",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(agent_memory_hits_total[5m])",
          "legendFormat": "hits"
        },
        {
          "expr": "rate(agent_memory_misses_total[5m])",
          "legendFormat": "misses"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queue depth per agent",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "agent_queue_depth",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Publication candidates",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(agent_publication_candidates_total[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Draft generation share (1h)",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (increase(agent_drafts_generated_total[1h]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Publication actions (Sprint 3)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(publication_decisions_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Agent state distribution",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (to) (rate(agent_state_transitions_total[5m]))",
          "legendFormat": "-> {{to}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Cluster types",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (cluster_type) (rate(trend_clusters_created_total[5m]))",
          "legendFormat": "{{cluster_type}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Draft evolution",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (draft_type) (rate(draft_evolution_total[5m]))",
          "legendFormat": "{{draft_type}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Global candidates",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(global_candidates_total[5m])",
          "legendFormat": "global candidates"
        }
      ]
    },
    {
      "id": 12,
      "title": "Communication funnel (1h)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(nexus_trends_consumed_total[1h]))",
          "legendFormat": "1. trends consumed"
        },
        {
          "expr": "sum(increase(trend_clusters_created_total[1h]))",
          "legendFormat": "2. clusters opened"
        },
        {
          "expr": "sum(increase(publication_decisions_total{action!=\"IGNORE\"}[1h]))",
          "legendFormat": "3. non-ignore decisions"
        },
        {
          "expr": "sum(increase(agent_drafts_generated_total[1h]))",
          "legendFormat": "4. drafts generated"
        },
        {
          "expr": "sum(increase(agent_publication_candidates_total[1h]))",
          "legendFormat": "5. publication candidates"
        }
      ]
    },
    {
      "id": 13,
      "title": "Cluster lifecycle (Sprint 3.5)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (cluster_type) (rate(trend_clusters_created_total[5m]))",
          "legendFormat": "opened {{cluster_type}}"
        },
        {
          "expr": "sum by (state) (rate(nexus_cluster_closures_total[5m]))",
          "legendFormat": "closed {{state}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Cluster closures by reason (1h)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(nexus_cluster_closures_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Story health distribution",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(nexus_story_health_score_bucket[15m])))",
          "legendFormat": "median health"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(nexus_story_health_score_bucket[15m])))",
          "legendFormat": "p90 (top stories)"
        },
        {
          "expr": "histogram_quantile(0.1, sum by (le) (rate(nexus_story_health_score_bucket[15m])))",
          "legendFormat": "p10 (worst stories)"
        }
      ]
    },
    {
      "id": 16,
      "title": "Story health average",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(nexus_story_health_score_sum[15m])) / sum(rate(nexus_story_health_score_count[15m]))",
          "legendFormat": "avg health"
        }
      ]
    },
    {
      "id": 17,
      "title": "Consumer health",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(nexus_pending_claimed_total[5m])",
          "legendFormat": "claimed"
        },
        {
          "expr": "rate(nexus_retries_total[5m])",
          "legendFormat": "retries"
        },
        {
          "expr": "rate(nexus_dlq_total[5m])",
          "legendFormat": "dead-lettered"
        }
      ]
    },
    {
      "id": 18,
      "title": "Match closure",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(nexus_match_sweeps_total[1h]))",
          "legendFormat": "sweeps (1h)"
        },
        {
          "expr": "sum(increase(nexus_sweep_retrospectives_total[1h]))",
          "legendFormat": "retrospectives generated (1h)"
        },
        {
          "expr": "sum(increase(nexus_cluster_closures_total{reason=\"match_finished\"}[1h]))",
          "legendFormat": "narratives closed at fulltime (1h)"
        }
      ]
    },
    {
      "id": 19,
      "title": "Provider health (Sprint 4)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "nexus_provider_health",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 20,
      "title": "LLM latency p95 by provider",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(nexus_llm_latency_seconds_bucket[15m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 21,
      "title": "Draft generation (LLM-composed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 80
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(nexus_drafts_generated_total[15m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Publication success vs failures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 80
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(nexus_publications_total[15m]))",
          "legendFormat": "{{agent}} published"
        },
        {
          "expr": "sum by (stage) (rate(nexus_publication_failures_total[15m]))",
          "legendFormat": "failed: {{stage}}"
        }
      ]
    },
    {
      "id": 23,
      "title": "Provider fallbacks",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 88
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider) (rate(nexus_fallbacks_total[15m]))",
          "legendFormat": "{{provider}} failed over"
        }
      ]
    },
    {
      "id": 24,
      "title": "Ticket volume",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 88
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (increase(nexus_tickets_created_total[6h]))",
          "legendFormat": "{{agent}} (6h)"
        }
      ]
    },
    {
      "id": 25,
      "title": "Spam prevention",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 96
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (rule) (increase(nexus_spam_prevented_total[6h]))",
          "legendFormat": "{{rule}} (6h)"
        }
      ]
    },
    {
      "id": 26,
      "title": "Agent publication activity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 96
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (increase(nexus_publications_total[24h]))",
          "legendFormat": "{{agent}} posts (24h)"
        }
      ]
    },
    {
      "id": 27,
      "title": "Console ticket reviews",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 104
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(console_ticket_reviews_total[5m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "description": "Sprint 4.5 \u2014 Console operations."
    },
    {
      "id": 28,
      "title": "Console publications (ticket + manual)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 104
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(console_publications_total[5m])) + sum(rate(console_manual_publications_total[5m]))",
          "legendFormat": "publications",
          "refId": "A"
        }
      ],
      "description": "Sprint 4.5 \u2014 Console operations."
    },
    {
      "id": 29,
      "title": "Manual publications by agent",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 112
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(console_manual_publications_total[5m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "description": "Sprint 4.5 \u2014 Console operations."
    },
    {
      "id": 30,
      "title": "Agent changes (enable/disable/persona)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 112
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(console_agent_changes_total[5m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "description": "Sprint 4.5 \u2014 Console operations."
    },
    {
      "id": 31,
      "title": "Provider incidents observed by Console",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 120
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(console_provider_incidents_total[1h]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "description": "Sprint 4.5 \u2014 Console operations."
    },
    {
      "id": 32,
      "title": "Console audit events",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 120
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(console_audit_events_total[5m]))",
          "legendFormat": "audit events",
          "refId": "A"
        }
      ],
      "description": "Sprint 4.5 \u2014 Console operations."
    }
  ]
}