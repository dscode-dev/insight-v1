# Nexus runtime. Key-name template only — never put real values here.
#
# Two independent switches gate publication:
#   NEXUS_PUBLISHER_ENABLED  turns the publish worker on at all
#   NEXUS_ENABLE_<PROVIDER>  registers one LLM adapter
#
# The publisher refuses to boot with neither a provider nor a Social
# address: with no provider it would open a ticket for every single draft,
# which is a misconfiguration that looks like a workload.

# ---- identity -------------------------------------------------------------
# Shared secret with the Insight Control Plane, the administrative authority.
# EMPTY = the admin API is locked (503) and nothing under /v1 answers.
NEXUS_CONTROL_PLANE_TOKEN=

# LEGACY fallback: operator-session introspection against Insight Gateway.
# Only consulted when NEXUS_CONTROL_PLANE_TOKEN is empty. Per
# insight-context.md v2.0 the Gateway is not responsible for operators, so
# this exists to keep an un-migrated deployment working, not as an option.
NEXUS_GATEWAY_IDENTITY_URL=

# ---- publication ----------------------------------------------------------
NEXUS_PUBLISHER_ENABLED=false
NEXUS_SOCIAL_GRPC_ADDR=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NEXUS_PROVIDER_ORDER=anthropic,openai,gemini
NEXUS_DEFAULT_PROVIDER=anthropic

NEXUS_ENABLE_OPENAI=false
NEXUS_ENABLE_ANTHROPIC=false
NEXUS_ENABLE_GEMINI=false

# ---- publishing queues ----------------------------------------------------
# Their own consumer group, deliberately separate from the trend group:
# resetting one must never reset the other.
NEXUS_PUBLISH_CONSUMER_GROUP=insight-nexus-publish
NEXUS_PUBLISH_CONSUMER_NAME=publisher-1

# ---- pending recovery -----------------------------------------------------
# Left unset, MIN_IDLE is DERIVED from NEXUS_LLM_TIMEOUT x provider count.
# A value below that lets a second consumer reclaim an in-flight trend while
# the first is still inside an LLM call — and both would publish.
# NEXUS_CLAIMER_MIN_IDLE=
NEXUS_LLM_TIMEOUT=60
