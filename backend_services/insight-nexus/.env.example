# Nexus private-provider runtime. Empty keys and false enable flags keep every
# provider offline. NEXUS_PUBLISHER_ENABLED must also remain false in ML-D.2.

OPENAI_API_KEY=sk-api-key
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=

NEXUS_PROVIDER_ORDER=anthropic,openai,gemini

NEXUS_DEFAULT_PROVIDER=anthropic

NEXUS_ENABLE_OPENAI=false
NEXUS_ENABLE_ANTHROPIC=false
NEXUS_ENABLE_GEMINI=false
